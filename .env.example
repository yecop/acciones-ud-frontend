# Copia este archivo a `.env.local` para sobrescribir valores en tu máquina.

# Origen del backend (sin barra final ni /api/v1). Vacío = mismo origen.
# En desarrollo, Vite redirige /api al backend (VITE_PROXY_TARGET).
VITE_API_BASE_URL=

# Backend al que apunta el proxy de desarrollo (`npm run dev`).
VITE_PROXY_TARGET=http://localhost:8080

# "true" usa el servidor mock (MSW) en lugar del backend. `npm start` ya lo activa.
VITE_USE_MOCK=false
